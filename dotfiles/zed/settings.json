{
  "languages": {
    "YAML": {
      "formatter": "language_server",
      "format_on_save": "off",
      "tab_size": 2
    },
    "JSON": {
      "format_on_save": "off",
     "tab_size": 2
    }
  },
  "hard_tabs": false,
  "tab_size": 2,
  "format_on_save": "off",
  "formatter": "language_server",
  "lsp": {
    "settings": {
      "yaml": {
        "format": {
          "enable": false
        },
        "editor": {
          "formatOnType": false,
          "tabSize": 2
        }
      }
    }
  }
}
